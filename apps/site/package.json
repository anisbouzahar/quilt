{
  "name": "@quilt/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "dependencies": {
    "@quilt/ui": "workspace:*",
    "fumadocs-core": "16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-ui": "16.18.0",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "pele": "^1.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@quilt/eslint-config": "workspace:*",
    "@quilt/prettier-config": "workspace:*",
    "@quilt/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "2.0.14",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "~6.0.3"
  },
  "prettier": "@quilt/prettier-config"
}
