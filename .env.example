# API Server
PORT=3000
# Exact allowed origins, comma-separated. Expo web defaults to port 8081.
CORS_ORIGINS=http://localhost:8081

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=quilt
POSTGRES_PASSWORD=quilt
POSTGRES_DB=quilt
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quilt:quilt@localhost:5432/quilt

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=quilt-development-secret-must-be-changed-in-production-1234567890

# Social Providers (Optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Mailpit (local email testing via docker-compose)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
